# Shared defaults, committed to the repo. To change something on just your
# machine, copy the line into `.env.local` and edit it there - that file is
# already gitignored (via *.local) and overrides this one.
#
# Restart the dev server after editing either file. Vite reads env files at
# startup and does not hot-reload them.


# Port the dev server listens on.
VITE_PORT=5173


# Where /api/... requests are forwarded.
#
# Leave this as 127.0.0.1 even when hosting for other computers. Vite proxies
# server-side: a visitor's request goes to your laptop first, and your laptop
# then talks to the backend over its own loopback. Only change this if the
# FastAPI backend runs on a DIFFERENT machine than the dev server.
VITE_API_TARGET=http://127.0.0.1:8000
